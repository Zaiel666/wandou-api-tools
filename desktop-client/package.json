{
  "name": "wandou-ai-desktop",
  "version": "2.0.22",
  "description": "豌豆AI Windows 客户端",
  "main": "main.js",
  "author": "PeaFour",
  "license": "UNLICENSED",
  "private": true,
  "scripts": {
    "start": "electron .",
    "pack:portable-folder": "electron-builder --win dir --x64"
  },
  "devDependencies": {
    "electron": "45.1.0",
    "electron-builder": "^26.0.12",
    "playwright": "^1.62.1",
    "sharp": "^0.35.3"
  },
  "build": {
    "appId": "com.peafour.wandouai",
    "productName": "豌豆AI工具",
    "copyright": "Copyright © 2026 PeaFour",
    "asar": true,
    "directories": {
      "output": "dist"
    },
    "files": [
      "main.js",
      "preload.js",
      "save-file-as.cjs",
      "canvas-media-writer.cjs",
      "canvas-media-protocol.cjs",
      "canvas-media-location.cjs",
      "project-storage.cjs",
      "storage-maintenance.cjs",
      "canvas-backup-guard.cjs",
      "director-ipc.cjs",
      "director-converter.cjs",
      "shell.html",
      "shell.css",
      "shell.js",
      "client-config.json",
      "package.json",
      "ipc-policy.cjs",
      "update-policy.cjs"
    ],
    "extraResources": [
      {
        "from": "../tools/director-blender/convert-blend.py",
        "to": "director/convert-blend.py"
      },
      {
        "from": "../app",
        "to": "app",
        "filter": [
          "**/*",
          "!ui-v2-lab.html",
          "!homepage-modern-preview.html",
          "!homepage-modern-preview.css",
          "!gridform-logo.png"
        ]
      },
      {
        "from": "portable-updater.ps1",
        "to": "portable-updater.ps1"
      },
      {
        "from": "portable-updater.exe",
        "to": "portable-updater.exe"
      }
    ],
    "win": {
      "icon": "../app/logo.ico",
      "target": [
        {
          "target": "dir",
          "arch": [
            "x64"
          ]
        }
      ]
    }
  }
}
